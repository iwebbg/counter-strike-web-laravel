{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "fragzone/counter-strike-web",
    "type": "project",
    "description": "A modern Counter-Strike server portal.",
    "license": "MIT",
    "require": {"php": "^8.5", "laravel/framework": "^13.17", "laravel/tinker": "^3.0"},
    "require-dev": {"fakerphp/faker": "^1.23", "laravel/pint": "^1.27", "mockery/mockery": "^1.6", "nunomaduro/collision": "^8.6", "phpunit/phpunit": "^12.5"},
    "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
    "autoload-dev": {"psr-4": {"Tests\\": "tests/"}},
    "scripts": {"post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"], "test": ["@php vendor/bin/phpunit --do-not-cache-result"]},
    "config": {"optimize-autoloader": true, "preferred-install": "dist", "sort-packages": true},
    "minimum-stability": "stable",
    "prefer-stable": true
}

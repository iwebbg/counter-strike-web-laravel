APP_NAME=FragZone
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Sofia
APP_LOCALE=bg
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mariadb
DB_HOST=database
DB_PORT=3306
DB_DATABASE=fragzone
DB_USERNAME=fragzone
DB_PASSWORD=fragzone-local-password
DB_ROOT_PASSWORD=change-root-password

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=
CACHE_STORE=database
QUEUE_CONNECTION=database
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
AUTO_MIGRATE=true
GAME_QUERY_TIMEOUT_SECONDS=1.0
GAME_QUERY_MAX_PACKET_BYTES=65535
LOG_CHANNEL=stack
LOG_LEVEL=debug
